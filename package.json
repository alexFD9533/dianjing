{
  "name": "web-visual-workbench",
  "private": true,
  "version": "0.1.0",
  "description": "点睛：AI 创作的最后一笔。",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @workbench/dock-extension dev",
    "build:dock": "pnpm --filter @workbench/dock-extension build",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "format:check:public": "prettier --check --ignore-unknown README.md docs/README.md CONTRIBUTING.md SECURITY.md CODE_OF_CONDUCT.md CHANGELOG.md NOTICE docs/open-source .github eslint.config.mjs package.json",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:dock:e2e": "node scripts/validate-dock-e2e.mjs",
    "test:dock:workspace": "node scripts/validate-dock-workspace-e2e.mjs",
    "build": "pnpm --filter @workbench/contracts build && pnpm --filter @workbench/selector-engine build && pnpm --filter @workbench/dock-extension build"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@playwright/test": "^1.55.0",
    "@types/chrome": "^0.0.307",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.36.0",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
